/* ========================================================= *
 *    Animals and Druids butchery in the Druid Grove area    *
 * ========================================================= */
IF
	OR(2)
		Global("D9CERNDmoving","GLOBAL",0)
		Global("CerndWentHunting","GLOBAL",1)
	Global("HelpCernd","GLOBAL",1)
THEN
	RESPONSE #100
		ActionOverride("CERND",JumpToPoint([4027.657]))
		SetGlobal("D9CERNDmoving","GLOBAL",1)
END


IF
	Global("D9addvilain","AR1900",0)
THEN
	RESPONSE #100
		SetGlobal("D9addvilain","AR1900",1)
 		CreateCreature("d9FGT09",[2160.696],12) // Shadow Druid - Druide de l'ombre
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
END

IF
	Global("D9beginbutchery","AR1900",1)
	Global("D9druidmessage","AR1900",0)
THEN
	RESPONSE #100
	    DisplayStringHead(Player1,@14661)  // ~Les ennemis semblent arriver de partout !~
		SetGlobal("D9druidmessage","AR1900",1)
END

IF
	Global("D9beginbutchery","AR1900",1)
	GlobalLT("MaxSpawn","AR1900",35)
	GlobalLT("EXTRACOUNT","MYAREA",6)
	ActionListEmpty()
	InActiveArea(Myself)
THEN
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR1900",1)
		CreateCreatureOffScreen("D9EARBL",S)  // Ours noir
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR1900",1)
		CreateCreatureOffScreen("D9IDSM01",S)  // Petite araignée
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR1900",1)
		CreateCreatureOffScreen("D9CATT",S)  // Panthère
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR1900",1)
		CreateCreatureOffScreen("D9CAX",S)  // Lion tacheté
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR1900",1)
		CreateCreatureOffScreen("D9LFWI01",S)  // Loup des glaces
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR1900",1)
		CreateCreatureOffScreen("D9IDPH01",S)  // Araignée éclipsante
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
END

IF
	Global("D9beginbutchery","AR1900",1)
	GlobalLT("MaxSpawn","AR1900",35)
	GlobalLT("EXTRACOUNT2","MYAREA",1)
