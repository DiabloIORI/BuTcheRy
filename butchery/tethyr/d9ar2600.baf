/* ========================================================= *
 *    Animals and Druids butchery in the Forest of Tethyr    *
 * ========================================================= */

IF
	Global("D9addvilaiiGG","AR2600",0)
THEN
	RESPONSE #100
 		CreateCreature("d9FGT0H",[4490.2278],12)  // Shadow Druid - Druide de l'ombre
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
		SetGlobal("D9addvilaiiGG","AR2600",1)
END

IF
	Global("D9beginbutchery","AR2600",1)
	Global("D9druidmessage","AR2600",0)
THEN
	RESPONSE #100
	    DisplayStringHead(Player1,@14661)  // ~Les ennemis semblent arriver de partout !~
		SetGlobal("D9druidmessage","AR2600",1)
END

IF
	Global("D9beginbutchery","AR2600",1)
	GlobalLT("MaxSpawn","AR2600",55)
	GlobalLT("EXTRACOUNT","MYAREA",6)
	ActionListEmpty()
	InActiveArea(Myself)
THEN
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9CATJ",S)  // Panthère
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9CAT",S)  // Lion tacheté
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9EARBL",S)  // Ours noir
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
END

IF
	Global("D9beginbutchery","AR2600",1)
	GlobalLT("MaxSpawn","AR2600",55)
	GlobalLT("EXTRACOUNT2","MYAREA",4)
	OR(2)
		Difficulty(HARD)
		Difficulty(HARDEST)
	ActionListEmpty()
	InActiveArea(Myself)
THEN
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("d9FGT02",S)  // Druide de l'ombre
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("d9FGT04",S)  // Druide de l'ombre
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9VBEA9",S)  // Ours brun
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9AKEB01",S)  // Boalisk
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9VBEA9",S)  // Ours brun
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9AKEB01",S)  // Boalisk
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
END

IF
	Global("D9beginbutchery","AR2600",1)
	GlobalLT("MaxSpawn","AR2600",55)
	GlobalLT("EXTRACOUNT3","MYAREA",2)
	Difficulty(HARDEST)
	ActionListEmpty()
	InActiveArea(Myself)
THEN
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("d9RUID",S)  // Druide
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9ARPO01",S)  // Ours de montagne
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9IDSM02",S)  // Araignée mutante
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9ARPO01",S)  // Ours de montagne
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR2600",1)
		CreateCreatureOffScreen("D9IDSM02",S)  // Araignée mutante
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
END