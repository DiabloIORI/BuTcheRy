IF
	Global("D9addvilain","AR0205",0)
THEN
	RESPONSE #100
		SetGlobal("D9addvilain","AR0205",1)
 		CreateCreature("D9BRAIX",[2442.1837],12) // Elite Garde
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
END


IF
	Global("D9beginbutchery","AR0205",1)
	GlobalLT("MaxSpawn","AR0205",70)
	GlobalLT("EXTRACOUNT","MYAREA",5)
	ActionListEmpty()
	InActiveArea(Myself)
THEN
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9mbju01",S)  // Zombie
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9ast0G",S)  // Blême
		IncrementGlobal("EXTRACOUNT","MYAREA",1)
END

IF
	Global("D9beginbutchery","AR0205",1)
	GlobalLT("MaxSpawn","AR0205",70)
	GlobalLT("EXTRACOUNT2","MYAREA",4)
	OR(2)
		Difficulty(HARD)
		Difficulty(HARDEST)
	ActionListEmpty()
	InActiveArea(Myself)
THEN
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9AIWA2",S)  // Prêtre aveugle
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9guard6",S)  // Garde d'élite
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("D9OGRRT",S)  // Goule Majeure
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9guard6",S)  // Garde d'élite
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("D9OGRRT",S)  // Goule Majeure
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9guard6",S)  // Garde d'élite
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("D9OGRRT",S)  // Goule Majeure
		IncrementGlobal("EXTRACOUNT2","MYAREA",1)
END

IF
	Global("D9beginbutchery","AR0205",1)
	GlobalLT("MaxSpawn","AR0205",70)
	GlobalLT("EXTRACOUNT3","MYAREA",2)
	Difficulty(HARDEST)
	ActionListEmpty()
	InActiveArea(Myself)
THEN
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9ltbh3",S)  // Spectateur
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("D9BRAIm",S)  // Prêtre aveugle
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9ltbh1",S)  // Gauth
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9guard4",S)  // Garde d'élite
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9guard4",S)  // Garde d'élite
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
	RESPONSE #100
		IncrementGlobal("MaxSpawn","AR0205",1)
		CreateCreatureOffScreen("d9guard4",S)  // Garde d'élite
		IncrementGlobal("EXTRACOUNT3","MYAREA",1)
END